# Database Dialect ('postgres' | 'supabase')
DB_DIALECT=postgres

# Direct Connection URL (preferred if available)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable

# Individual Connection Parameters (used if DATABASE_URL is not set)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=postgres
PG_SSL=false

# Migration File Location
MIGRATIONS_DIR=/app/migrations

# Tracking Table Configuration
# Use 'public' for standard PostgreSQL, or 'supabase_migrations' for Supabase instances
TRACKING_SCHEMA=public
TRACKING_TABLE=schema_migrations

# PostgREST Cache Reload Notification (auto-enabled when TRACKING_SCHEMA=supabase_migrations)
POSTGREST_RELOAD_NOTIFY=false

# Dry-run flag (simulates execution without modifying database)
DRY_RUN=false

# Retry Configuration on Startup
PG_CONNECT_MAX_RETRIES=30
PG_CONNECT_RETRY_INTERVAL_MS=2000

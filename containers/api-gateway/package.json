{
  "name": "@quatrain/api-gateway",
  "version": "1.0.39",
  "description": "API Gateway and Cache Proxy for Core",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external '*'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quatrain/Core.git",
    "directory": "containers/api-gateway"
  },
  "dependencies": {
    "@quatrain/api": "*",
    "ioredis": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.11.0"
  }
}
